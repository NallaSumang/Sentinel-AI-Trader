# Groq API Key (Required for AI News Analysis and Options Signal Generation)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Alpaca Paper Trading API Credentials (NEVER USE LIVE KEYS)
# Get free Paper Trading API keys at: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Alpaca Paper Trading Endpoint (Paper Sandbox Only)
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional Risk Parameters
RISK_MIN_CONFIDENCE=0.70
RISK_MAX_POSITION_PCT=0.10
RISK_MAX_ORDER_QTY=25
RISK_MAX_TRADES_PER_SESSION=10
